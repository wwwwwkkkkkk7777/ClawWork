{
  "name": "clawwork",
  "version": "0.1.0",
  "description": "Self-hostable mobile workspace for durable AI-assisted tasks",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwwwwkkkkkk7777/ClawWork.git"
  },
  "homepage": "https://github.com/wwwwwkkkkkk7777/ClawWork#readme",
  "bugs": {
    "url": "https://github.com/wwwwwkkkkkk7777/ClawWork/issues"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check:workspace": "node scripts/check-workspace.mjs",
    "compose:check": "powershell -NoProfile -File scripts/check-compose.ps1",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/compose/docker-compose.yml down -v",
    "demo:up": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.demo.yml up -d --build",
    "demo:down": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.demo.yml down",
    "demo:smoke": "node scripts/smoke-demo.mjs",
    "check:open-source": "node scripts/check-open-source.mjs",
    "check:history": "node scripts/check-history.mjs",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "prisma:generate": "pnpm --filter @clawwork/database prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter @clawwork/database exec prisma migrate deploy --schema prisma/schema.prisma",
    "smoke:backend": "powershell -NoProfile -File scripts/smoke-backend.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vitest": "^3.0.8",
    "ws": "^8.21.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@xmldom/xmldom": "0.8.15",
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "deepmerge-ts": "8.0.0",
      "defu": "6.1.7",
      "effect": "3.21.0",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "node-forge": "1.4.0",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "qs": "6.16.0",
      "shell-quote": "1.10.0",
      "uuid": "11.1.1",
      "ws@7": "7.5.11",
      "ws@8": "8.21.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
